{
  "version": 2,
  "framework": "nextjs",
  "functions": {
    "app/**/*": {
      "maxDuration": 60
    }
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "$NEXT_PUBLIC_API_URL"
  },
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next"
}